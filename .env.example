# Base de datos: PostgreSQL en Supabase.
# Copia la cadena de conexión desde tu proyecto en supabase.com:
#   Project Settings -> Database -> Connection string
#
# Para desarrollo local basta con la conexión directa (puerto 5432) en
# ambas variables. Si más adelante despliegas en un entorno serverless
# (Vercel, edge functions, etc.), cambia DATABASE_URL por la cadena de
# "Connection pooling" (puerto 6543, Transaction mode) para no agotar las
# conexiones de Postgres; DIRECT_URL siempre debe ser la conexión directa,
# porque Prisma la necesita para `db push` / `migrate`.
DATABASE_URL="postgresql://postgres:<tu-password>@db.<ref-del-proyecto>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<tu-password>@db.<ref-del-proyecto>.supabase.co:5432/postgres"
