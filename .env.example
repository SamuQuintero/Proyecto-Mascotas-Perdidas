# Base de datos: PostgreSQL en Supabase.
# Copia estos dos valores desde tu proyecto en supabase.com:
#   Project Settings -> Database -> Connection string
#
# DATABASE_URL: usa el "Connection pooling" (Transaction mode, puerto 6543).
# Es la conexión que usa la aplicación en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.<ref-del-proyecto>:<tu-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: usa la conexión directa (puerto 5432, sin pooler).
# Prisma la necesita solo para `prisma db push` / `prisma migrate`.
DIRECT_URL="postgresql://postgres.<ref-del-proyecto>:<tu-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
