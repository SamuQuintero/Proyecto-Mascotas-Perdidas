# Base de datos: PostgreSQL en Supabase.
# Copia estos dos valores desde tu proyecto en supabase.com:
#   Project Settings -> Database -> Connection string -> Connection pooling
#
# Usamos el pooler (aws-0-<region>.pooler.supabase.com) y no la conexión
# directa (db.<ref>.supabase.co): la conexión directa solo resuelve por
# IPv6 salvo que el proyecto tenga el add-on de IPv4, y muchas redes no
# tienen salida IPv6 — el pooler es dual-stack y funciona siempre.
#
# Si tu contraseña tiene caracteres especiales (@, $, %, etc.), codifícalos
# como percent-encoding (ej. "$" -> "%24").
DATABASE_URL="postgresql://postgres.<ref-del-proyecto>:<tu-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref-del-proyecto>:<tu-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Acceso de administrador (botón "Admin" del navbar). Solo el administrador
# inicia sesión, para editar reportes y marcarlos como reencontrados; el
# resto de la aplicación se usa sin cuenta. Pide las credenciales reales al
# equipo: no las subas al repositorio.
ADMIN_USUARIO="<usuario-admin>"
ADMIN_CONTRASENA="<contraseña-admin>"
# Clave para firmar la cookie de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se omite, se deriva de las credenciales.
ADMIN_SECRETO="<cadena-aleatoria-larga>"

# Dominio público donde se publica la aplicación (sin "/" al final). Lo usa
# el código QR de las placas de mascota: si no se define, el QR apunta a la
# dirección con la que se abrió la página (p. ej. localhost, que no funciona
# al escanearlo desde otro celular).
# URL_PUBLICA="https://petmatch.ejemplo.com"
