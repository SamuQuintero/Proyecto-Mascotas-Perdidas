// Modelo de datos: un único reporte que representa tanto mascotas perdidas
// (HU-1, HU-13, HU-3) como mascotas encontradas (HU-2, HU-5). En el Sprint 2
// se agregan el estado REENCONTRADA (HU-12) y la fecha de última edición
// (HU-25), e índices para los filtros del listado (HU-6).
// El campo `tipo` diferencia el caso de uso sin duplicar el modelo.
//
// Base de datos: PostgreSQL alojado en Supabase.
// `url` usa el connection pooler de Supabase (para las consultas de la app
// en runtime) y `directUrl` usa la conexión directa (puerto 5432), que
// Prisma necesita para `db push` / `migrate` porque el pooler en modo
// transacción no soporta declaraciones preparadas.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TipoReporte {
  PERDIDA
  ENCONTRADA
}

enum Tamano {
  PEQUENO
  MEDIANO
  GRANDE
}

// ACTIVO: el caso sigue abierto. REENCONTRADA (HU-12): la mascota volvió
// a casa y el reporte deja de aparecer como pendiente.
enum EstadoReporte {
  ACTIVO
  REENCONTRADA
}

model Reporte {
  id   String      @id @default(cuid())
  tipo TipoReporte

  // Datos mínimos obligatorios (HU-13)
  especie String
  color   String
  tamano  Tamano
  zona    String
  // Fecha y hora (hora de Colombia) en que se perdió o se encontró la
  // mascota. Los reportes anteriores a este cambio solo tenían fecha y
  // quedaron a las 00:00 de ese día.
  fecha   DateTime

  // Datos opcionales de la mascota
  raza              String?
  nombre            String?
  tieneCollar       Boolean?
  senasParticulares String?

  // Fotografía (HU-1 / HU-5): ruta relativa servida desde /uploads
  fotoUrl String

  // Ubicación geográfica (HU-3)
  latitud  Float
  longitud Float

  // Información de contacto (opcional para reportes anónimos de HU-2)
  contactoNombre   String?
  contactoTelefono String?
  contactoEmail    String?

  // HU-2: permite registrar un hallazgo sin crear cuenta
  reportanteAnonimo Boolean @default(false)

  estado         EstadoReporte @default(ACTIVO)
  reencontradaEn DateTime?
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @default(now()) @updatedAt

  mensajes Mensaje[]

  @@index([tipo])
  @@index([estado])
  @@index([fecha])
  @@index([especie])
}

// HU-11: mensajes dentro de la plataforma, ligados a un reporte en lugar de
// a una cuenta de usuario (ni el dueño ni el hallador necesitan cuenta). El
// hilo vive en la propia página pública del reporte: no expone teléfono ni
// dirección, solo texto.
model Mensaje {
  id        String   @id @default(cuid())
  reporteId String
  reporte   Reporte  @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  autor     String // nombre libre de quien escribe ("Dueño", "Anónimo", etc.)
  texto     String
  creadoEn  DateTime @default(now())

  @@index([reporteId])
}

// HU-16 / HU-17: cuentas reales, separadas del admin único (que sigue
// viviendo en variables de entorno). CIUDADANO se suscribe a avisos de
// cercanía; VETERINARIA consulta los reportes (sin poder modificarlos) y
// lleva el carnet de vacunas de las mascotas registradas.
enum RolUsuario {
  CIUDADANO
  VETERINARIA
}

model Usuario {
  id             String     @id @default(cuid())
  nombre         String
  email          String     @unique
  contrasenaHash String
  rol            RolUsuario

  // CIUDADANO (HU-16): punto de referencia y radio para los avisos de
  // cercanía de mascotas perdidas. Null hasta que configura su suscripción.
  avisoLatitud  Float?
  avisoLongitud Float?
  avisoRadioKm  Int?

  // VETERINARIA (HU-17)
  nombreClinica String?

  creadoEn DateTime @default(now())

  @@index([rol])
}

// HU-8: perfil digital de una mascota con código QR imprimible. Es
// independiente de los reportes: se crea antes de que la mascota se pierda,
// y el QR de su placa lleva a este perfil con los datos de contacto.
model Mascota {
  id                String   @id @default(cuid())
  nombre            String
  especie           String
  raza              String?
  color             String
  tamano            Tamano
  senasParticulares String?
  fotoUrl           String
  contactoNombre    String
  contactoTelefono  String
  contactoEmail     String?
  creadoEn          DateTime @default(now())

  vacunas Vacuna[]
}

// HU-17: carnet de vacunas de una mascota. Lo escribe una veterinaria, y
// cualquiera con el enlace del perfil (el mismo QR de la placa) lo puede
// consultar — es el "carnet" físico, pero digital.
model Vacuna {
  id          String   @id @default(cuid())
  mascotaId   String
  mascota     Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  nombre      String // p. ej. "Rabia", "Parvovirus", "Moquillo"
  fecha       DateTime // fecha en que se aplicó
  veterinaria String // nombre de la clínica que la registró
  creadoEn    DateTime @default(now())

  @@index([mascotaId])
}
